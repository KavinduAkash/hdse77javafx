	<parameter name="ORDER_ID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT oi.id, oi.order_id, oi.item_id, oi.qty, oi.unit_price, i.name as item_name FROM order_detail oi JOIN item i ON oi.item_id = i.id WHERE oi.order_id=$P{ORDER_ID}]]></query>
